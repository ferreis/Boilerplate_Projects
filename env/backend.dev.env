# Configuração da Aplicação
## Nome exibido pela API.
APP_NAME=Meu Backend
## Ambiente de execução. Use development apenas localmente.
APP_ENV=development
## Prefixo público das rotas da API.
BASE_URL=/api
## Hosts aceitos nas requisições, separados por vírgula.
TRUSTED_HOSTS=localhost,127.0.0.1
## Origens autorizadas a chamar a API via CORS, separadas por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:5173
## Tamanho máximo permitido para o corpo de uma requisição, em bytes.
MAX_REQUEST_BODY_BYTES=1048576

# Configuração de Autenticação e Sessão
## Chave usada para assinar tokens JWT. Gere um valor aleatório com ao menos 32 caracteres.
JWT_SECRET=
## Algoritmo usado para assinar e validar os tokens JWT.
JWT_ALGORITHM=HS256
## Emissor informado nos tokens JWT.
JWT_ISSUER=meu-backend
## Tempo de validade do token de acesso, em minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=15
## Tempo de validade do token de renovação, em dias.
REFRESH_TOKEN_EXPIRE_DAYS=2
## Define se o cookie de autenticação exige HTTPS. Em produção, mantenha true.
AUTH_COOKIE_SECURE=false

# Configuração do Usuário Inicial
## Nome de usuário autorizado a acessar a API.
AUTH_USERNAME=admin
## Hash bcrypt da senha. Gere com: python -c "import bcrypt; print(bcrypt.hashpw(b'sua-senha', bcrypt.gensalt()).decode())"
AUTH_PASSWORD_HASH=
## Perfis de acesso do usuário, separados por vírgula.
AUTH_USER_ROLES=authenticated
