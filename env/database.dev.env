# Configuração do PostgreSQL
## Usuário administrador criado na primeira inicialização do banco.
POSTGRES_USER=app_user
## Senha do usuário administrador. Use uma senha longa e aleatória fora do ambiente local.
POSTGRES_PASSWORD=611ef039a13c63bb0eb3c29c9d5f67426c78413bf8a8ab42053153318bdb5458
## Nome do banco de dados criado na primeira inicialização.
POSTGRES_DB=app_db
## Diretório interno usado pelo PostgreSQL para armazenar os dados.
PGDATA=/var/lib/postgresql/data/pgdata
